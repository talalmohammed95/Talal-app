# Add these in Vercel › Project › Settings › Environment Variables (Production and Preview).

# PostgreSQL connection string. Vercel › Storage › Neon adds it automatically.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# The one admin account. Register in the app with this email; it's approved automatically.
ADMIN_EMAIL=you@yourcompany.com

# Optional: email for sign-up confirmation, approval notices and password resets (any SMTP provider).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Orla Properties <no-reply@yourcompany.com>"

# Optional: the site's address for links in emails. Defaults to the Vercel production address.
APP_URL=
